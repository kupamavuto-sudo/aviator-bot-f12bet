{
  "manifest_version": 3,
  "name": "Aviator Bot - F12.bet",
  "version": "1.0.0",
  "description": "Bot automatizado para Aviator com Stop Win, Stop Loss e Gales ajustáveis",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://f12.bet/*",
    "https://*.f12.bet/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://f12.bet/*", "https://*.f12.bet/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
